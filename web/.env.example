# Pastel L&D — variáveis do frontend (Vercel → Settings → Environment Variables)

# Deixe VAZIO em produção: o site chama /api no próprio domínio e a Vercel
# encaminha para o backend (veja vercel.json). Assim os cookies de login ficam seguros.
VITE_API_URL=

# Endereço DIRETO do backend para o WebSocket (tempo real). Rewrites não encaminham WebSocket.
VITE_SOCKET_URL=https://SEU-BACKEND.onrender.com

# Somente desenvolvimento: para onde o Vite encaminha /api (padrão http://localhost:4000)
DEV_API_TARGET=http://localhost:4000
