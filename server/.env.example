# ---------------------------------------------------------------
# Pastel L&D — variáveis do backend (copie para .env)
# NUNCA versione o arquivo .env com valores reais.
# ---------------------------------------------------------------

NODE_ENV=production
PORT=4000

# PostgreSQL (Render, Neon, Supabase...). Exemplo:
# DATABASE_URL=postgresql://usuario:senha@host:5432/pastelld?sslmode=require
# Desenvolvimento sem Postgres instalado (npm run dev:db):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true
DATABASE_URL=

# Segredos — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 64 caracteres hexadecimais (32 bytes) — criptografa credenciais salvas no banco
ENCRYPTION_KEY=

# Endereço público do site (frontend). Usado nos links das mesas/NFC/QR e nas mensagens.
PUBLIC_APP_URL=https://pastelld.com.br
# Endereço público usado para montar a URL das imagens enviadas (modo local).
# Com o rewrite da Vercel, pode ser o próprio domínio do site.
PUBLIC_API_URL=https://pastelld.com.br
# Outras origens permitidas no CORS/WebSocket, separadas por vírgula (ex.: domínio da Vercel)
CORS_ORIGINS=https://pastel-ld.vercel.app
# Quantidade de proxies na frente da API (Render = 1)
TRUST_PROXY=1

# ---------------- Armazenamento das fotos ----------------
# s3 = recomendado (Cloudflare R2, AWS S3, Supabase Storage, Backblaze B2)
# local = disco do servidor (no Render, exige "Persistent Disk" montado em UPLOAD_DIR)
STORAGE_DRIVER=s3
UPLOAD_DIR=./uploads
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=pastelld-imagens
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (domínio público do R2 ou CDN)
S3_PUBLIC_BASE_URL=https://imagens.pastelld.com.br

# ---------------- WhatsApp Business Platform (Cloud API) ----------------
# Opcional. Sem isso o sistema funciona com envio manual (wa.me).
# O Phone Number ID e os templates são configurados no painel (Integrações).
WHATSAPP_API_VERSION=v21.0
# Token permanente de usuário do sistema (tem prioridade sobre o salvo no painel)
WHATSAPP_ACCESS_TOKEN=
# Segredo do app Meta — valida a assinatura do webhook
WHATSAPP_APP_SECRET=
# Texto livre que você define e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=

# ---------------- Primeiro acesso (usado só pelo seed) ----------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
